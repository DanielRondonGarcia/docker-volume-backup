# Copy selected non-secret values to /etc/docker-volume-backup/worker.env.
# Keep one-time enrollment material out of persistent package-managed examples.
CONTROL_PLANE_URL=https://backups.example.com
WORKER_NAME=worker-linux-01
WORKER_RUNTIME=native
WORKER_RUN_ONCE=false
WORKER_POLL_INTERVAL_SECONDS=15
WORKER_HEALTH_PORT=8081
WORKER_CREDENTIAL_FILE=/var/lib/docker-volume-backup/worker_credentials.json
